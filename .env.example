# Example .env for navidrome-scripts
# Fill these values, don't commit real secrets into .env.example
BASE_URL=http://navidrome.sickgaming.net/
TOKEN=ifyouhaveatokenuseithere
USERNAME=your_navidrome_username
PASSWORD=your_navidrome_password
FROM_RATING=5
TO_RATING=2
ARTIST=3Lu5a2hhygk22VnEcfKkwY

# Read-only Lidarr library review
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=

# Preferred names for playlist synchronization (BASE_URL/USERNAME/PASSWORD also work)
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# Spotify user OAuth: existing access token, or refresh token plus client ID
SPOTIFY_ACCESS_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_TOKEN_FILE=logs/spotify-playlists/spotify-token.json
